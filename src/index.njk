---
layout: base.njk
title: Aaron Beaudoin
description: Aaron Beaudoin is a UX designer in the Denver metro area, with a background in sales leadership, business ownership, and astrophysics.
---
<div class="wrap">
  <header class="hero">
    <p class="eyebrow">UX Designer · {{ site.location }}</p>
    <h1>{{ site.name }}</h1>
    <p class="hero__line">I'm a UX designer with seven years in sales leadership and running my own business. I design products around the people who use them.</p>
    <div class="button-row">
      <a class="button" href="#work">See my work</a>
      <a class="button button--ghost" href="/about/">About me</a>
    </div>
  </header>

  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="section__head">
      <h2 id="work-heading">Selected work</h2>
    </div>
    {%- asyncEach p in projects %}{% ifAsync p.featured %}
    {% set c = p %}{% set featured = true %}{% set headingLevel = 3 %}{% include "card.njk" %}
    {%- endif %}{% endeach %}
    <ul class="card-grid" role="list" style="margin-top:1.25rem">
      {%- asyncEach p in projects %}{% ifAsync not p.featured %}
      <li>{% set c = p %}{% set featured = false %}{% set headingLevel = 3 %}{% include "card.njk" %}</li>
      {%- endif %}{% endeach %}
    </ul>
  </section>

  {% include "testimonials.njk" %}
</div>

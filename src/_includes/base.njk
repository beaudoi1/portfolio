<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " | " + site.name) if title and title != site.name else site.name + " | UX Designer" %}
  <title>{{ pageTitle }}</title>
  {%- if description %}
  <meta name="description" content="{{ description }}">
  {%- endif %}
  {%- if draft %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  {%- if description %}
  <meta property="og:description" content="{{ description }}">
  {%- endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/files/og-image.jpg">
  <meta property="og:image:alt" content="Aaron Beaudoin's ATB logo on a starfield">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#0b0d14">
  <link rel="icon" type="image/png" sizes="32x32" href="/files/favicon-32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/files/favicon-48.png">
  <link rel="apple-touch-icon" href="/files/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="wordmark" href="/"><img class="wordmark__logo" src="/files/logo-small.jpg" alt="" width="64" height="34">{{ site.name }}</a>
      <nav class="site-nav" aria-label="Main">
        {#- Phone-size menu button. Hidden until the script below runs, so the full menu still shows without JavaScript. -#}
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav-list" hidden>
          <span class="nav-toggle__icon" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="nav-toggle__label">Menu</span>
        </button>
        <ul class="nav" id="site-nav-list">
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
          {%- if site.resume %}
          <li><a href="{{ site.resume }}">Resume <span class="visually-hidden">(PDF)</span></a></li>
          {%- endif %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    {%- if draft %}
    <p class="draft-banner">Draft: only visible in local preview. Not published.</p>
    {%- endif %}
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <ul class="footer-links">
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="{{ site.linkedin }}">LinkedIn</a></li>
        <li><a href="{{ site.github }}">GitHub</a></li>
        {%- if site.resume %}
        <li><a href="{{ site.resume }}">Resume <span class="visually-hidden">(PDF)</span></a></li>
        {%- endif %}
        <li><a href="/accessibility/">Accessibility</a></li>
      </ul>
      <p class="footer-meta">© {{ site.year }} {{ site.name }} · {{ site.location }}</p>
    </div>
  </footer>

  <dialog class="lightbox" aria-label="Enlarged image">
    <div class="lightbox__bar">
      <div class="lightbox__zoom" role="group" aria-label="Zoom">
        <button type="button" class="lightbox__btn" data-zoom-out aria-label="Zoom out">−</button>
        <span class="lightbox__level" aria-live="polite">Fit</span>
        <button type="button" class="lightbox__btn" data-zoom-in aria-label="Zoom in">+</button>
        <button type="button" class="lightbox__btn" data-zoom-fit>Fit</button>
      </div>
      <button type="button" class="lightbox__btn" data-lightbox-close>Close</button>
    </div>
    <div class="lightbox__stage" tabindex="0" aria-label="Image. When zoomed, use the arrow keys to move around."><img class="lightbox__img" alt="" draggable="false"></div>
    <p class="lightbox__caption"></p>
    <p class="lightbox__hint">Pinch or Ctrl + scroll to zoom. Drag to move around.</p>
  </dialog>
  <script src="/js/lightbox.js" defer></script>

  <script>
    // Hamburger menu for phone-size screens.
    (function () {
      var root = document.documentElement;
      var button = document.querySelector(".nav-toggle");
      var list = document.getElementById("site-nav-list");
      if (!button || !list) return;
      root.classList.add("has-nav-toggle");
      button.hidden = false;
      function setOpen(open) {
        button.setAttribute("aria-expanded", String(open));
        list.classList.toggle("is-open", open);
      }
      button.addEventListener("click", function () {
        setOpen(button.getAttribute("aria-expanded") !== "true");
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
          setOpen(false);
          button.focus();
        }
      });
      // Close if the screen grows past phone size.
      window.matchMedia("(min-width: 48rem)").addEventListener("change", function () { setOpen(false); });
    })();
  </script>
</body>
</html>

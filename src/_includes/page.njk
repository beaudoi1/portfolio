---
layout: base.njk
---
<div class="wrap">
  <header class="page-head">
    {%- if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {%- if lede %}<p class="lede">{% if ledeProposed %}{% proposed %}{{ lede | safe }}{% endproposed %}{% else %}{{ lede | safe }}{% endif %}</p>{% endif %}
  </header>
  <div class="panel">
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</div>
